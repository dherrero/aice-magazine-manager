# Coolify v4 Environment Variables
# Copy these variables to your Coolify project settings

# Database Configuration
POSTGRESDB_USER=postgres
POSTGRESDB_PASSWORD=your_secure_password_here
POSTGRESDB_DATABASE=aice_magazine
POSTGRESDB_PORT=5432
POSTGRESDB_HOST=postgresdb

# Node.js Configuration
NODE_PORT=3200
NODE_JWT_SECRET=your_super_secure_jwt_secret_here_change_this_in_production
NODE_JWT_ACCESS_EXPIRES_IN=15m
NODE_JWT_REFRESH_EXPIRES_IN=7d
NODE_HASH_SALT_ROUNDS=10
NODE_PRODUCTION=true
NODE_UPLOAD_FILES=uploads

# Frontend Configuration
FRONT_PORT=80
